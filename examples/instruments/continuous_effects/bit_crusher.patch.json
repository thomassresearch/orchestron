    "ui_layout": {
      "input_formulas": {
        "bc_drive_gain::ksig": {
          "expression": "ampdb(db)",
          "inputs": [
            {
              "token": "db",
              "from_node_id": "bc_drive",
              "from_port_id": "iout"
            }
          ]
        },
        "bc_steps::ksig": {
          "expression": "floor(ampdb(6.020599913279624 * (floor(bits + 0.5) - 1)) + 0.5)",
          "inputs": [
            {
              "token": "bits",
              "from_node_id": "bc_bits",
              "from_port_id": "iout"
            }
          ]
        },
        "bc_mix_audio::ksig": {
          "expression": "mix",
          "inputs": [
            {
              "token": "mix",
              "from_node_id": "bc_mix",
              "from_port_id": "iout"
            }
          ]
        },
        "bc_gain::ksig": {
          "expression": "ampdb(db)",
          "inputs": [
            {
              "token": "db",
              "from_node_id": "bc_output",
              "from_port_id": "iout"
            }
          ]
        },
        "bc_clip_left::a": {
          "expression": "(abs(input * drive + 1) - abs(input * drive - 1)) / 2",
          "inputs": [
            {
              "token": "input",
              "from_node_id": "bc_in_left",
              "from_port_id": "asignal"
            },
            {
              "token": "drive",
              "from_node_id": "bc_drive_gain",
              "from_port_id": "aout"
            }
          ]
        },
        "bc_quant_left::a": {
          "expression": "floor(input * q + 0.5) / q",
          "inputs": [
            {
              "token": "input",
              "from_node_id": "bc_hold_left",
              "from_port_id": "aout"
            },
            {
              "token": "q",
              "from_node_id": "bc_steps",
              "from_port_id": "aout"
            }
          ]
        },
        "bc_limit_left::a": {
          "expression": "(input + 1 - 1 / q - abs(input - (1 - 1 / q))) / 2",
          "inputs": [
            {
              "token": "input",
              "from_node_id": "bc_quant_left",
              "from_port_id": "aout"
            },
            {
              "token": "q",
              "from_node_id": "bc_steps",
              "from_port_id": "aout"
            }
          ]
        },
        "bc_mix_left::a": {
          "expression": "(dry * (1 - mix) + wet * mix) * gain",
          "inputs": [
            {
              "token": "dry",
              "from_node_id": "bc_in_left",
              "from_port_id": "asignal"
            },
            {
              "token": "wet",
              "from_node_id": "bc_limit_left",
              "from_port_id": "aout"
            },
            {
              "token": "mix",
              "from_node_id": "bc_mix_audio",
              "from_port_id": "aout"
            },
            {
              "token": "gain",
              "from_node_id": "bc_gain",
              "from_port_id": "aout"
            }
          ]
        },
        "bc_clip_right::a": {
          "expression": "(abs(input * drive + 1) - abs(input * drive - 1)) / 2",
          "inputs": [
            {
              "token": "input",
              "from_node_id": "bc_in_right",
              "from_port_id": "asignal"
            },
            {
