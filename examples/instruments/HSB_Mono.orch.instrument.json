        "tone_value::ksig": {
          "expression": "base * (1 - ceil(cc / 127)) + (0 + (cc - 1) / 126 * 1) * ceil(cc / 127) + 0",
          "inputs": [
            {
              "token": "base",
              "from_node_id": "hsb_tonality",
              "from_port_id": "iout"
            },
            {
              "token": "cc",
