            {
              "token": "channel",
              "from_node_id": "hsb_cc_channel",
              "from_port_id": "iout"
            }
          ]
        },
        "brightness_value::isig": {
          "expression": "base + 2",
          "inputs": [
            {
              "token": "base",
              "from_node_id": "hsb_brightness",
              "from_port_id": "iout"
            }
          ]
        },
        "brightness_value::ksig": {
          "expression": "base * (1 - ceil(cc / 127)) + (-2 + (cc - 1) / 126 * 4) * ceil(cc / 127) + 2",
          "inputs": [
            {
              "token": "base",
              "from_node_id": "hsb_brightness",
              "from_port_id": "iout"
            },
            {
              "token": "cc",
              "from_node_id": "brightness_cc",
              "from_port_id": "kout"
            }
          ]
        },
        "glide_cc::ichan": {
          "expression": "floor(channel + 0.5)",
          "inputs": [
            {
              "token": "channel",
              "from_node_id": "hsb_cc_channel",
              "from_port_id": "iout"
            }
          ]
        },
        "glide_value::isig": {
          "expression": "base + 0",
          "inputs": [
            {
              "token": "base",
              "from_node_id": "hsb_legato_rate",
              "from_port_id": "iout"
            }
          ]
        },
        "glide_value::ksig": {
          "expression": "base * (1 - ceil(cc / 127)) + (0.001 * ampdb((cc - 1) / 126 * 53.979400086720375)) * ceil(cc / 127) + 0",
          "inputs": [
            {
              "token": "base",
              "from_node_id": "hsb_legato_rate",
              "from_port_id": "iout"
            },
            {
              "token": "cc",
              "from_node_id": "glide_cc",
              "from_port_id": "kout"
            }
          ]
        },
        "glide_pitch::khtim": {
          "expression": "rate * (1 - onset * (1 - floor(memory + 0.5)))",
          "inputs": [
            {
              "token": "rate",
              "from_node_id": "glide_value",
              "from_port_id": "kout"
            },
            {
              "token": "memory",
              "from_node_id": "recent_activity",
              "from_port_id": "kout"
            },
            {
              "token": "onset",
              "from_node_id": "phrase_onset",
              "from_port_id": "kenv"
            }
          ]
        },
        "pitch_octaves::a": {
          "expression": "dbamp(pitch / 261.6255653005986) / 6.020599913279624",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "glide_pitch",
              "from_port_id": "kout"
            }
          ]
        },
        "hsb_oscillator::ktone": {
          "expression": "octave + tone + 8",
          "inputs": [
            {
              "token": "octave",
              "from_node_id": "pitch_octaves",
              "from_port_id": "kout"
            },
            {
              "token": "tone",
              "from_node_id": "tone_value",
              "from_port_id": "kout"
            }
          ]
        },
        "hsb_oscillator::kbrite": {
          "expression": "octave + brightness - 2",
          "inputs": [
            {
              "token": "octave",
              "from_node_id": "pitch_octaves",
              "from_port_id": "kout"
            },
            {
              "token": "brightness",
