      "opcode": "vco2",
      "gain": 0.09,
      "mode": 0
    },
    {
      "id": "saw_b",
      "opcode": "vco2",
      "gain": 0.09,
      "mode": 0
    },
    {
      "id": "pulse",
      "opcode": "vco2",
      "gain": 0.065,
      "mode": 2
    }
  ],
  "output": {
    "pan": 0.5
  },
  "design": {
    "slug": "string_ensemble",
    "instrument_type": "melody",
