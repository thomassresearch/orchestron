{
  "name": "EBM DW — Sequencer Bass",
  "description": "Lean dry pulse/saw bass for short external sixteenth-note sequences. Velocity changes filter brightness; no built-in sequencer.",
  "family": "subtractive",
  "envelope": {
    "attack": 0.003,
    "decay": 0.15,
    "sustain": 0.35,
    "release": 0.06
  },
