      "id": "pulse",
      "opcode": "vco2",
      "gain": 0.15,
      "mode": 2
    },
    {
      "id": "saw_a",
      "opcode": "vco2",
      "gain": 0.09,
      "mode": 0
    }
  ],
  "output": {
    "pan": 0.5
  },
  "design": {
    "slug": "sequencer_bass",
