      "opcode": "vco2",
      "gain": 0.13,
      "mode": 0
    },
    {
      "id": "pulse",
      "opcode": "vco2",
      "gain": 0.06,
      "mode": 2
    },
    {
      "id": "sub",
      "opcode": "oscili",
      "gain": 0.12,
      "table": 1
    }
  ],
  "output": {
    "pan": 0.5
  },
  "design": {
    "slug": "ebm_analog_bass",
    "instrument_type": "bass",
    "register": [
