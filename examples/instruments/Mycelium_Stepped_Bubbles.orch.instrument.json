    "ui_layout": {
      "audio_blocks": {
        "main-output": true
      },
      "input_formulas": {
        "stepped_value::a": {
          "expression": "floor((first + second + 2) * 2)",
          "inputs": [
            {
              "token": "first",
              "from_node_id": "step_lfo_a",
              "from_port_id": "kout"
            },
            {
              "token": "second",
              "from_node_id": "step_lfo_b",
              "from_port_id": "kout"
            }
          ]
        },
        "echo_sum::a": {
          "expression": "0.62000000 * tap1 + 0.38440000 * tap2 + 0.23832800 * tap3 + 0.14776336 * tap4",
          "inputs": [
            {
              "token": "tap1",
              "from_node_id": "echo_1",
              "from_port_id": "aout"
            },
            {
              "token": "tap2",
              "from_node_id": "echo_2",
              "from_port_id": "aout"
            },
            {
              "token": "tap3",
              "from_node_id": "echo_3",
              "from_port_id": "aout"
            },
            {
              "token": "tap4",
              "from_node_id": "echo_4",
              "from_port_id": "aout"
            }
          ]
        },
        "local_reverb::asig": {
          "expression": "0.45 * dry + 0.55 * echoes",
          "inputs": [
            {
              "token": "dry",
              "from_node_id": "effect_2_butterhp",
              "from_port_id": "aout"
            },
            {
              "token": "echoes",
              "from_node_id": "echo_sum",
              "from_port_id": "aout"
            }
          ]
        },
        "fx_mix::a": {
          "expression": "dry + space * (0.75 * echoes + 0.38 * reverb)",
          "inputs": [
            {
              "token": "dry",
              "from_node_id": "effect_2_butterhp",
              "from_port_id": "aout"
            },
            {
              "token": "space",
              "from_node_id": "space_audio",
              "from_port_id": "aout"
            },
            {
              "token": "echoes",
              "from_node_id": "echo_sum",
              "from_port_id": "aout"
            },
            {
              "token": "reverb",
              "from_node_id": "local_reverb",
              "from_port_id": "aout"
            }
          ]
        },
        "output_pan2::asig": {
          "expression": "6 * audio * tail",
          "inputs": [
            {
              "token": "audio",
              "from_node_id": "fx_mix",
              "from_port_id": "aout"
            },
            {
              "token": "tail",
              "from_node_id": "tail_audio",
              "from_port_id": "aout"
            }
          ]
        },
        "output_pan2::xp": {
          "expression": "0.5 + 0.22 * motion",
          "inputs": [
            {
              "token": "motion",
              "from_node_id": "orbit_pan_lfo",
              "from_port_id": "kout"
            }
          ]
        },
        "step_lfo_b::kcps": {
          "expression": "rate * 0.731",
          "inputs": [
            {
              "token": "rate",
              "from_node_id": "mycelium_rate",
              "from_port_id": "iout"
            }
          ]
        },
        "voice_pitch::a": {
          "expression": "pitch * (1 + mutation * (step * 0.375 - 0.75))",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "pitch_cpsmidi",
              "from_port_id": "kfreq"
            },
            {
              "token": "mutation",
              "from_node_id": "mycelium_mutation",
              "from_port_id": "iout"
            },
            {
              "token": "step",
              "from_node_id": "stepped_value",
              "from_port_id": "kout"
            }
          ]
        },
        "effect_1_moogladder2::xcf": {
          "expression": "700 + step * 600",
          "inputs": [
            {
              "token": "step",
              "from_node_id": "stepped_value",
              "from_port_id": "kout"
            }
          ]
        },
        "voice_foscili::xamp": {
          "expression": "amplitude * (0.25 + 0.75 * abs(motion))",
          "inputs": [
            {
              "token": "amplitude",
              "from_node_id": "voice_amp",
              "from_port_id": "kout"
