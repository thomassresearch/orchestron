{
  "sourcePatchId": "autopanner-v1",
  "name": "Autopanner",
  "description": "Continuous stereo Autopanner with separate left/right paths and a smooth sine sweep. Tempo (40–180 BPM, default 120), Beats per cycle (0.125–16, default 4), Depth (0–1, default 1). One cycle lasts 60 * Beats / Tempo seconds. Depth 0 passes audio unchanged; Depth 1 alternately attenuates each channel to silence. Gains never exceed unity. Starts centered, moving right; phase resets on rack start. Set tempo manually: no arranger synchronization. Use as a mixer insert. Restart the rack after changing settings.",
  "isTemplate": false,
  "alwaysOn": true,
  "instrumentType": "continuous",
  "schema_version": 1,
