{
  "sourcePatchId": "3a1a3e13-4dbe-491c-8834-e5a13626a686",
  "name": "Stereo Chorus",
  "description": "Continuous stereo chorus with twelve audio-rate sine LFOs. Amount (0.001\u20130.1 s, default 0.02) controls every LFO amplitude; each tap uses base + Amount + LFO, keeping delays between 14 and 230.5 ms inside a 250 ms buffer. LFO Frequency Multiplier (0.1\u201310, default 1). Wet taps share averaged stereo input and 8% normalized feedback; dry channels retain the existing 10% mix. Large Amount values produce longer modulated delays. Restart the rack after changing controls.",
  "isTemplate": false,
  "alwaysOn": true,
  "instrumentType": "continuous",
