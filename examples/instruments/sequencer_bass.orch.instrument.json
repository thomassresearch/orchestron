      "input_formulas": {
        "pulse_vco2::kcps": {
          "expression": "pitch",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "pitch_cpsmidi",
              "from_port_id": "kfreq"
            }
          ]
