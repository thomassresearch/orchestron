        "saw_a_vco2::kcps": {
          "expression": "pitch * 0.9965",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "pitch_cpsmidi",
              "from_port_id": "kfreq"
            }
          ]
        },
        "source_sum::a": {
          "expression": "s0 + s1",
          "inputs": [
            {
              "token": "s0",
              "from_node_id": "pulse_vco2",
              "from_port_id": "asig"
            },
            {
              "token": "s1",
              "from_node_id": "saw_a_vco2",
              "from_port_id": "asig"
            }
          ]
        },
        "voice_filter::xcf": {
          "expression": "tone + 2600 * sweep * (.2 + .8 * velocity * accent)",
          "inputs": [
            {
              "token": "tone",
              "from_node_id": "ctl_tone",
              "from_port_id": "iout"
            },
            {
              "token": "sweep",
              "from_node_id": "filter_decay_envelope",
              "from_port_id": "kenv"
            },
            {
              "token": "velocity",
              "from_node_id": "velocity_ampmidi",
              "from_port_id": "iamp"
            },
            {
              "token": "accent",
              "from_node_id": "ctl_accent",
              "from_port_id": "iout"
            }
          ]
        },
        "saturation::kpregain": {
          "expression": "drive * 3",
          "inputs": [
            {
              "token": "drive",
              "from_node_id": "ctl_drive",
              "from_port_id": "iout"
            }
          ]
        },
        "saturation::kpostgain": {
          "expression": "1 / (1 + .55 * (drive - 1))",
          "inputs": [
            {
              "token": "drive",
              "from_node_id": "ctl_drive",
              "from_port_id": "iout"
            }
          ]
        },
        "output_pan2::asig": {
          "expression": "audio * 0.58",
          "inputs": [
            {
              "token": "audio",
              "from_node_id": "dc_filter",
              "from_port_id": "aout"
            }
          ]
        }
