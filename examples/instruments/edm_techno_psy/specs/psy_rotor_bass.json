{
  "name": "Psy Rotor Bass",
  "description": "Phase-reset saw for rolling psy bass. Tone is the floor of a 3500 Hz envelope sweep; mild saturation precedes the ladder filter. Suggested MIDI notes 28–52. Dry, velocity-sensitive, polyphonic. Three per-instance controls read on new notes. Route Stereo Output through the performance mixer to Master.",
  "family": "subtractive",
  "envelope": {
    "attack": 0.002,
    "decay": 0.1,
    "sustain": 0,
    "release": 0.012
  },
  "layers": [
    {
      "id": "saw",
      "opcode": "vco2",
      "gain": 0.65,
      "mode": 0,
      "phase": 0
    }
  ],
  "effects": [
    {
      "opcode": "distort1",
      "pre_gain": 1.8,
      "post_gain": 0.42,
      "shape1": 0,
      "shape2": 0,
      "mode": 1
    },
    {
      "opcode": "moogladder2",
      "cutoff": 350,
      "resonance": 0.16
    }
  ],
  "output": {
    "pan": 0.5
  },
  "performance_controllers": [
    {
      "id": "rotor_decay",
      "target": "amp_madsr.idec",
      "label": "Decay (s)",
      "min": 0.04,
      "max": 0.25,
      "default": 0.1,
      "scale": "logarithmic"
    },
    {
      "id": "rotor_tone",
      "target": "effect_2_moogladder2.xcf",
      "label": "Tone (Hz)",
      "min": 100,
      "max": 1800,
      "default": 350,
      "scale": "logarithmic"
    },
    {
      "id": "rotor_drive",
      "target": "effect_1_distort1.kpregain",
      "label": "Drive",
      "min": 1,
      "max": 5,
      "default": 1.8,
      "scale": "logarithmic"
    }
  ]
}
