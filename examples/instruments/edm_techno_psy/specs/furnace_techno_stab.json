{
  "name": "Furnace Techno Stab",
  "description": "Saw and square at one played pitch, saturated into an envelope-swept resonant filter. Play your own chords; no fixed chord or unison. Suggested MIDI notes 43–79. Dry, velocity-sensitive, polyphonic. Three per-instance controls read on new notes. Route Stereo Output through the performance mixer to Master.",
  "family": "subtractive",
  "envelope": {
    "attack": 0.003,
    "decay": 0.22,
    "sustain": 0,
    "release": 0.08
  },
  "layers": [
    {
      "id": "saw",
      "opcode": "vco2",
      "gain": 0.45,
      "mode": 0,
      "phase": 0
    },
    {
      "id": "square",
      "opcode": "vco2",
      "gain": 0.3,
      "mode": 2,
      "pulse_width": 0.5,
      "phase": 0.25
    }
  ],
  "effects": [
    {
      "opcode": "distort1",
      "pre_gain": 2,
      "post_gain": 0.25,
      "shape1": 0,
      "shape2": 0,
      "mode": 1
    },
    {
      "opcode": "moogladder2",
      "cutoff": 1100,
      "resonance": 0.28
    },
    {
      "opcode": "butterhp",
      "cutoff": 100
    }
  ],
  "output": {
    "pan": 0.5
  },
  "performance_controllers": [
    {
      "id": "furnace_tone",
      "target": "effect_2_moogladder2.xcf",
      "label": "Tone (Hz)",
      "min": 200,
      "max": 6000,
      "default": 1100,
      "scale": "logarithmic"
    },
    {
      "id": "furnace_decay",
      "target": "amp_madsr.idec",
      "label": "Decay (s)",
      "min": 0.06,
      "max": 1,
      "default": 0.22,
      "scale": "logarithmic"
    },
    {
      "id": "furnace_drive",
      "target": "effect_1_distort1.kpregain",
      "label": "Drive",
      "min": 1,
      "max": 8,
      "default": 2,
      "scale": "logarithmic"
    }
  ]
}
