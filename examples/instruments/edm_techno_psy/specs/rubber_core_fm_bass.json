{
  "name": "Rubber Core FM Bass",
  "description": "One 1:2 FM pair plus a sine at the played fundamental. Growl fades with the envelope to a sustained rubbery body. Suggested MIDI notes 28–55. Dry, velocity-sensitive, polyphonic. Three per-instance controls read on new notes. Route Stereo Output through the performance mixer to Master.",
  "family": "fm_pad",
  "envelope": {
    "attack": 0.003,
    "decay": 0.25,
    "sustain": 0.15,
    "release": 0.05
  },
  "layers": [
    {
      "id": "fm",
      "opcode": "foscili",
      "gain": 0.24,
      "carrier_ratio": 1,
      "mod_ratio": 2,
      "mod_index": 2,
      "table": 1,
      "phase": 0
    },
    {
      "id": "body",
      "opcode": "oscili",
      "gain": 0.14,
      "table": 1
    }
  ],
  "effects": [
    {
      "opcode": "moogladder2",
      "cutoff": 900,
      "resonance": 0.12
    }
  ],
  "output": {
    "pan": 0.5
  },
  "performance_controllers": [
    {
      "id": "rubber_growl",
      "target": "fm_foscili.kndx",
      "label": "Growl",
      "min": 0.3,
      "max": 6,
      "default": 2,
      "scale": "logarithmic"
    },
    {
      "id": "rubber_tone",
      "target": "effect_1_moogladder2.xcf",
      "label": "Tone (Hz)",
      "min": 150,
      "max": 3500,
      "default": 900,
      "scale": "logarithmic"
    },
    {
      "id": "rubber_decay",
      "target": "amp_madsr.idec",
      "label": "Decay (s)",
      "min": 0.08,
      "max": 1.2,
      "default": 0.25,
      "scale": "logarithmic"
    }
  ]
}
