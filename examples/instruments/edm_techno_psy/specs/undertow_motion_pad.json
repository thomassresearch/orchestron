{
  "name": "Undertow Motion Pad",
  "description": "Dark triangle and PWM pulse pad. Sine LFO moves pulse width from 0.32 to 0.68 and filter cutoff from 70% to 130% of Tone. Motion is Hz, not tempo sync. Suggested MIDI notes 43–79. Dry, velocity-sensitive, polyphonic. Three per-instance controls read on new notes. Route Stereo Output through the performance mixer to Master.",
  "family": "subtractive",
  "envelope": {
    "attack": 0.6,
    "decay": 1.5,
    "sustain": 0.7,
    "release": 2.5
  },
  "layers": [
    {
      "id": "triangle",
      "opcode": "vco2",
      "gain": 0.14,
      "mode": 12,
      "phase": 0
    },
    {
      "id": "pulse",
      "opcode": "vco2",
      "gain": 0.09,
      "mode": 2,
      "pulse_width": 0.5,
      "phase": 0.25
    }
  ],
  "effects": [
    {
      "opcode": "butterhp",
      "cutoff": 70
    },
    {
      "opcode": "moogladder2",
      "cutoff": 1400,
      "resonance": 0.18
    }
  ],
  "output": {
    "pan": 0.5
  },
  "performance_controllers": [
    {
      "id": "undertow_tone",
      "target": "effect_2_moogladder2.xcf",
      "label": "Tone (Hz)",
      "min": 200,
      "max": 6000,
      "default": 1400,
      "scale": "logarithmic"
    },
    {
      "id": "undertow_release",
      "target": "amp_madsr.irel",
      "label": "Release (s)",
      "min": 0.2,
      "max": 6,
      "default": 2.5,
      "scale": "logarithmic"
    }
  ]
}
