{
  "spine": {
    "name": "World Drumkit",
    "description": "World Drumkit synthesis spine; see full voice spec.",
    "family": "simple_osc",
    "envelope": {
      "attack": 0.0007,
      "decay": 0.002,
      "sustain": 1,
      "release": 4
    },
    "layers": [
      {
        "id": "seed",
        "opcode": "oscili",
        "gain": 0.15,
        "table": -1
      }
    ],
    "output": {
      "pan": 0.5
    }
  },
  "description": "Sample-free, velocity-sensitive world percussion: 55 strokes, selected by If + MIDI notnum. Custom map; other notes are silent. Short notes retain decay; held notes do not sustain. Four performance controls: Kit tuning, Decay, Brightness, Tabla tuning (independent multiplier; default dayan C4, 261.63 Hz). Synthetic tabla bol approximations; ge bend is preset, not live pressure. Mono voices feed Stereo Output; route to Master.\n\nDeep foundation\n- 36: Dunun open; 37: Dunun muted\n- 38: Surdo open; 39: Surdo damped\n\nHand drums\n- 40: Djembe bass; 41: tone; 42: slap; 43: muted\n- 44: Conga low open; 45: high open; 46: muted; 47: slap\n- 48: Bongo low open; 49: high open; 50: rim; 51: muted\n- 52: Darbuka doum; 53: tek; 54: ka; 55: slap\n\nResonant / expressive\n- 56: Frame drum centre; 57: rim; 58: muted\n- 60: Tabla dayan na; 61: tin; 62: tun; 63: te (dry)\n- 64: Tabla bayan ge; 65: ke (muted); 66: pressure bend\n- 67: Tabla dha (na + ge); 68: dhin (tin + ge)\n- 70: Udu bass air pulse; 71: clay tap; 72: hole slap\n\nWood / dry accents\n- 74: Cajon bass; 75: snare slap; 76: edge\n- 77: Claves; 78: Woodblock low; 79: Woodblock high\n\nMetal\n- 80: Cowbell open; 81: damped\n- 82: Agogo low; 83: Agogo high\n\nShakers / scrapers / jingles\n- 84: Shekere short; 85: accent; 86: long\n- 87: Cabasa short; 88: Cabasa long\n- 89: Guiro short; 90: Guiro long\n- 91: Tambourine hit; 92: shake; 93: damped",
  "controllers": [
    {
      "id": "world_tuning",
      "label": "Kit tuning",
      "min": 0.8,
      "max": 1.25,
      "default": 1,
      "scale": "logarithmic"
