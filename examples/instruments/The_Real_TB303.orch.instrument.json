    "ui_layout": {
      "audio_blocks": {
        "main-output": true
      },
      "input_formulas": {
        "accent_flag::a": {
          "expression": "floor((vel * 128 + 32.001) / 128)",
          "inputs": [
            {
              "token": "vel",
              "from_node_id": "velocity_ampmidi",
              "from_port_id": "iamp"
            }
          ]
        },
        "portamento_flag::a": {
          "expression": "floor((vel * 128 + 64.001) / 128) - floor((vel * 128 + 32.001) / 128) + floor((vel * 128 + 16.001) / 128)",
          "inputs": [
            {
              "token": "vel",
              "from_node_id": "velocity_ampmidi",
              "from_port_id": "iamp"
            }
          ]
        },
        "slide_portk::khtim": {
          "expression": "in1 * (0.001 + slide * 0.059)",
          "inputs": [
            {
              "token": "slide",
              "from_node_id": "portamento_flag",
              "from_port_id": "kout"
            },
            {
              "token": "in1",
              "from_node_id": "4f581c79-0680-4d74-a075-ff4934223401",
              "from_port_id": "iout"
            }
          ]
        },
        "slide_portk::isig": {
          "expression": "pitch * (1 - (floor((vel * 128 + 64.001) / 128) - floor((vel * 128 + 32.001) / 128) + floor((vel * 128 + 16.001) / 128))) - (floor((vel * 128 + 64.001) / 128) - floor((vel * 128 + 32.001) / 128) + floor((vel * 128 + 16.001) / 128))",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "pitch_cpsmidi",
              "from_port_id": "kfreq"
            },
            {
              "token": "vel",
              "from_node_id": "velocity_ampmidi",
              "from_port_id": "iamp"
            }
          ]
        },
        "cutoff_smooth::ksig": {
          "expression": "40 * ampdb(cc * 52.04119982655925)",
          "inputs": [
            {
              "token": "cc",
              "from_node_id": "cutoff_cc10",
              "from_port_id": "kval"
            }
          ]
        },
        "filter_sum::kin": {
          "expression": "cutoff + env * env_mod * 4000 * (0.4 + accent * 0.4)",
          "inputs": [
            {
              "token": "cutoff",
              "from_node_id": "cutoff_smooth",
              "from_port_id": "kout"
            },
            {
              "token": "env",
              "from_node_id": "filter_envelope_mxadsr",
              "from_port_id": "kenv"
            },
            {
              "token": "accent",
              "from_node_id": "accent_flag",
              "from_port_id": "kout"
            },
            {
              "token": "env_mod",
              "from_node_id": "tb303_env_mod",
              "from_port_id": "iout"
            }
          ]
        },
        "soft_tanh::xin": {
          "expression": "signal * env * (0.4 + accent * 0.5) * drive * 1.5",
          "inputs": [
            {
              "token": "signal",
              "from_node_id": "highpass_atone",
              "from_port_id": "aout"
            },
            {
              "token": "env",
              "from_node_id": "vca_envelope",
              "from_port_id": "aout"
            },
            {
              "token": "accent",
              "from_node_id": "accent_flag",
              "from_port_id": "kout"
            },
            {
              "token": "drive",
              "from_node_id": "iamp_drive",
              "from_port_id": "iout"
            }
          ]
        },
        "output_pan2::asig": {
          "expression": "signal * 1.4142135623730951 * compensation",
          "inputs": [
            {
              "token": "signal",
              "from_node_id": "soft_tanh",
              "from_port_id": "aout"
            },
            {
              "token": "compensation",
              "from_node_id": "drive_compensation",
              "from_port_id": "aout"
            }
          ]
        },
        "drive_compensation::ksig": {
          "expression": "(1 + 0.025 * drive) / (1.025 * drive)",
