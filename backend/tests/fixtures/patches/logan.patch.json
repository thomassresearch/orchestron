    "ui_layout": {
      "input_formulas": {
        "note_gain::b": {
          "expression": "velocity * level",
          "inputs": [
            {
              "token": "velocity",
              "from_node_id": "velocity_ampmidi",
              "from_port_id": "iamp"
            },
            {
              "token": "level",
