        "phase_double::xcps": {
          "expression": "2 * pitch",
          "inputs": [
            {
              "token": "pitch",
              "from_node_id": "pitch",
              "from_port_id": "kfreq"
            }
          ]
        },
        "alternate::a": {
          "expression": "2 * half - phase",
          "inputs": [
            {
              "token": "half",
              "from_node_id": "phase_fundamental",
              "from_port_id": "aphase"
            },
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            }
          ]
        },
        "ramp_fold::asig": {
          "expression": "(2 - wet) * (1 - phase)",
          "inputs": [
            {
              "token": "wet",
              "from_node_id": "shape_sweep",
              "from_port_id": "aenv"
            },
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            }
          ]
        },
        "saw_shape::a": {
          "expression": "-(2 - wet) * (wet * (1 - phase) - fold) / (1 - wet) / 2 * (1 / (2 - wet) - 0.5)",
          "inputs": [
            {
              "token": "wet",
              "from_node_id": "shape_sweep",
              "from_port_id": "aenv"
            },
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            },
            {
              "token": "fold",
              "from_node_id": "ramp_fold",
              "from_port_id": "aout"
            }
          ]
        },
        "pick_limit::xin": {
          "expression": "(1 + 1 / (1 - wet)) * phase",
          "inputs": [
            {
              "token": "wet",
              "from_node_id": "shape_sweep",
              "from_port_id": "aenv"
            },
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            }
          ]
        },
        "pick_fold::asig": {
          "expression": "2 * value",
          "inputs": [
            {
              "token": "value",
              "from_node_id": "pick_limit",
              "from_port_id": "xout"
            }
          ]
        },
        "buzz_shape::a": {
          "expression": "pick * (0.5 - (1 - wet) / (2 - wet))",
          "inputs": [
            {
              "token": "pick",
              "from_node_id": "pick_fold",
              "from_port_id": "aout"
            },
            {
              "token": "wet",
              "from_node_id": "shape_sweep",
              "from_port_id": "aenv"
            }
          ]
        },
        "wave_one::asig": {
          "expression": "2 * (phase + shape) - 0.5",
          "inputs": [
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            },
            {
              "token": "shape",
              "from_node_id": "buzz_shape",
              "from_port_id": "aout"
            }
          ]
        },
        "cubic_one::a": {
          "expression": "value * (4 * value * value - 3)",
          "inputs": [
            {
              "token": "value",
              "from_node_id": "wave_one",
              "from_port_id": "aout"
            }
          ]
        },
        "wave_two::asig": {
          "expression": "2 * (phase + shape) - 0.5",
          "inputs": [
            {
              "token": "phase",
              "from_node_id": "phase_double",
              "from_port_id": "aphase"
            },
            {
              "token": "shape",
              "from_node_id": "saw_shape",
              "from_port_id": "aout"
            }
          ]
        },
        "cubic_two::a": {
          "expression": "value * (4 * value * value - 3)",
          "inputs": [
            {
              "token": "value",
              "from_node_id": "wave_two",
              "from_port_id": "aout"
            }
          ]
        },
        "alternate_mix::a": {
          "expression": "(1 - pulse) * one + pulse * two",
          "inputs": [
            {
              "token": "pulse",
              "from_node_id": "alternate",
              "from_port_id": "aout"
            },
            {
              "token": "one",
              "from_node_id": "cubic_one",
              "from_port_id": "aout"
            },
            {
              "token": "two",
              "from_node_id": "cubic_two",
              "from_port_id": "aout"
            }
          ]
        },
