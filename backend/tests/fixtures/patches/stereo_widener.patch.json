    "ui_layout": {
      "input_formulas": {
        "sw_mid::a": {
          "expression": "(left + right) / 2",
          "inputs": [
            {
              "token": "left",
              "from_node_id": "sw_in_left",
              "from_port_id": "asignal"
            },
            {
              "token": "right",
              "from_node_id": "sw_in_right",
              "from_port_id": "asignal"
            }
          ]
        },
        "sw_side::a": {
          "expression": "(left - right) / 2",
          "inputs": [
            {
              "token": "left",
              "from_node_id": "sw_in_left",
              "from_port_id": "asignal"
            },
            {
              "token": "right",
              "from_node_id": "sw_in_right",
              "from_port_id": "asignal"
            }
          ]
        },
        "sw_delayed_mid::idlt": {
          "expression": "time / 1000",
          "inputs": [
            {
              "token": "time",
              "from_node_id": "sw_delay",
              "from_port_id": "iout"
            }
          ]
        },
        "sw_width_audio::ksig": {
          "expression": "width",
          "inputs": [
            {
              "token": "width",
              "from_node_id": "sw_width",
              "from_port_id": "iout"
            }
          ]
        },
        "sw_mono_audio::ksig": {
          "expression": "mono",
          "inputs": [
            {
              "token": "mono",
              "from_node_id": "sw_mono",
              "from_port_id": "iout"
            }
          ]
        },
        "sw_gain::ksig": {
          "expression": "ampdb(db)",
          "inputs": [
            {
              "token": "db",
              "from_node_id": "sw_output",
              "from_port_id": "iout"
            }
          ]
        },
        "sw_spread::a": {
          "expression": "(side + amount * (mid - delayed) / 2) * width",
          "inputs": [
            {
              "token": "side",
              "from_node_id": "sw_side",
              "from_port_id": "aout"
            },
            {
              "token": "amount",
              "from_node_id": "sw_mono_audio",
              "from_port_id": "aout"
            },
            {
              "token": "mid",
              "from_node_id": "sw_mid",
              "from_port_id": "aout"
            },
            {
              "token": "delayed",
              "from_node_id": "sw_delayed_mid",
              "from_port_id": "aout"
            },
            {
              "token": "width",
              "from_node_id": "sw_width_audio",
              "from_port_id": "aout"
            }
          ]
        },
        "sw_left::a": {
          "expression": "(mid + side) * gain",
          "inputs": [
            {
              "token": "mid",
              "from_node_id": "sw_mid",
              "from_port_id": "aout"
            },
            {
              "token": "side",
              "from_node_id": "sw_spread",
              "from_port_id": "aout"
            },
            {
              "token": "gain",
              "from_node_id": "sw_gain",
              "from_port_id": "aout"
            }
          ]
        },
        "sw_right::a": {
          "expression": "(mid - side) * gain",
          "inputs": [
            {
              "token": "mid",
              "from_node_id": "sw_mid",
              "from_port_id": "aout"
            },
            {
              "token": "side",
              "from_node_id": "sw_spread",
              "from_port_id": "aout"
            },
            {
              "token": "gain",
              "from_node_id": "sw_gain",
              "from_port_id": "aout"
            }
          ]
        }
      },
